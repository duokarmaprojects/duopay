generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?   // Normalized E.164
  upiId                    String?
  role                     String    @default("USER") // USER, ADMIN
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  
  groupMembers  GroupMember[]
  expensesPaid  Expense[] // Expenses where this user is the payer
  expenseShares ExpenseParticipant[] // Shares in expenses
  
  settlementsPaid     Settlement[] @relation("SettlementsPaid")
  settlementsReceived Settlement[] @relation("SettlementsReceived")
  
  analyticsEvents     AnalyticsEvent[]
  settings            UserSettings?

  cashbackBalancePaise Int             @default(0)
  cashbackLedgers      CashbackLedger[]
  redemptions          RedemptionRequest[]

  referralCode         String?             @unique
  referredById         String?
  referredBy           User?               @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredUsers        User[]              @relation("UserReferrals")
  referralsSent        Referral[]          @relation("ReferralsSent")
  referralReceived     Referral?           @relation("ReferralReceived")
  pushSubscriptions    PushSubscription[]
  notifications        Notification[]
  friendshipsInitiated Friendship[]        @relation("FriendshipsInitiated")
  friendshipsReceived  Friendship[]        @relation("FriendshipsReceived")
  recurringExpenses    RecurringExpense[]
  automationRules      AutomationRule[]
  receiptScans         ReceiptScan[]
  orderImports         OrderImport[]
  groupMessages        GroupMessage[]
  expenseComments      ExpenseComment[]
  attachments          Attachment[]
}

// NextAuth standard models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Group {
  id          String   @id @default(cuid())
  name        String
  image       String?
  idempotencyKey String? @unique

  // Phase B: Trip & Collection Extensions
  type        String   @default("GROUP") // GROUP, TRIP, COLLECTION
  destination String?  
  startDate   DateTime?
  endDate     DateTime?
  targetAmount Int?    // in paise
  deadline    DateTime?
  poolOwnerId String?  // ID of the user holding the pool money (for trips/collections)
  status      String   @default("ACTIVE") // ACTIVE, TARGET_REACHED, EXPIRED, CLOSED

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
  recurringExpenses RecurringExpense[]
  messages          GroupMessage[]
  attachments       Attachment[]
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  joinedAt  DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Expense {
  id          String   @id @default(cuid())
  groupId     String?  
  description String
  category    String?
  amount      Int      // In paise! (e.g., 1100.50 = 10050)
  date        DateTime @default(now())
  payerId     String
  splitMethod String   @default("EQUAL") // V1 only EQUAL
  source      String   @default("MANUAL") // MANUAL, CASH, RECEIPT, SCREENSHOT, IMPORT, SHARE
  receiptUrl  String?
  metadata    String?  // JSON string
  isPoolExpense  Boolean @default(false)
  priority      String   @default("NORMAL")
  dueDate       DateTime?
  reminderAt    DateTime?
  status        String   @default("FINAL") // FINAL, UPCOMING, SKIPPED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  idempotencyKey String? @unique

  group       Group?   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  payer       User     @relation(fields: [payerId], references: [id], onDelete: Restrict)
  
  participants ExpenseParticipant[]
  receiptItems ReceiptItem[]
  comments     ExpenseComment[]
  attachments  Attachment[]
}

model ReceiptItem {
  id          String   @id @default(cuid())
  expenseId   String
  name        String
  price       Int      // paise
  quantity    Int      @default(1)
  assignedTo  String?  // JSON array of user IDs, or null for split equally

  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

model ExpenseParticipant {
  id        String   @id @default(cuid())
  expenseId String
  userId    String
  share     Int      // In paise, exact calculated share. Sum of all shares = Expense.amount

  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([expenseId, userId])
}

model Settlement {
  id                    String    @id @default(cuid())
  groupId               String?   // Optional, context for settlement
  payerId               String
  receiverId            String
  amount                Int       // In paise
  status                String    @default("COMPLETED") // INITIATED, COMPLETED, SETTLED, CANCELLED, FAILED
  paymentStatus         String    @default("MANUAL_CONFIRMED") // MANUAL_CONFIRMED, PROVIDER_INITIATED, PROVIDER_VERIFIED, WEBHOOK_VERIFIED, PENDING, FAILED, UNKNOWN
  paymentProvider       String?   // manual_confirmation, upi_intent, razorpay, cashfree
  providerTransactionId String?   // UTR or gateway payment ID
  verificationMethod    String?   // MANUAL_PEER_CONFIRMATION, WEBHOOK_HMAC, SERVER_API_QUERY, NONE
  verifiedAt            DateTime?
  verifiedAmount        Int?      // In paise
  processedEventId      String?   @unique // Provider webhook event ID for strict replay prevention
  paymentInitiatedAt    DateTime?
  paymentCompletedAt    DateTime?
  paymentFailureReason  String?
  settledAt             DateTime?
  payeeUpiId            String?
  note                  String?
  isPoolContribution    Boolean   @default(false)
  reportedAt            DateTime  @default(now())
  createdAt             DateTime  @default(now())
  idempotencyKey        String?   @unique

  group                 Group?    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  payer                 User      @relation("SettlementsPaid", fields: [payerId], references: [id], onDelete: Restrict)
  receiver              User      @relation("SettlementsReceived", fields: [receiverId], references: [id], onDelete: Restrict)
  cashbackLedgers       CashbackLedger[]

  @@index([providerTransactionId])
  @@index([paymentStatus])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventType   String
  userId      String?
  entityType  String?
  entityId    String?
  metadata    String?  // JSON string
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([createdAt])
  @@index([userId])
}

model SystemError {
  id          String   @id @default(cuid())
  code        String
  message     String
  stack       String?
  context     String?  // JSON string
  createdAt   DateTime @default(now())

  @@index([code])
  @@index([createdAt])
}


model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // General App Preferences
  currency             String   @default("INR") // INR, USD, EUR, GBP
  defaultSplitMethod   String   @default("EQUAL") // EQUAL, EXACT, PERCENTAGE, SHARES
  simplifyDebts        Boolean  @default(true)

  // Notifications
  expenseAlerts        Boolean  @default(true)
  paymentReminders     Boolean  @default(true)
  groupActivityAlerts  Boolean  @default(true)
  cashbackAlerts       Boolean  @default(true)
  referralAlerts       Boolean  @default(true)
  recurringReminders   Boolean  @default(true)
  pushNotifications    Boolean  @default(false)

  // Privacy & Visibility
  discoverableByPhone  Boolean  @default(true)
  shareActivityInGroup Boolean  @default(true)
  showUpiOnProfile     Boolean  @default(true)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model CashbackLedger {
  id                    String      @id @default(cuid())
  userId                String
  amountPaise           Int         // Positive for credit (EARNED, ADJUSTMENT), negative for debit (REDEEMED, REVERSAL)
  type                  String      // PAYMENT_CASHBACK, REDEMPTION, REVERSAL, ADJUSTMENT
  status                String      // EARNED, REDEEMED, REVERSED, PENDING, CANCELLED
  sourcePaymentId       String?
  providerTransactionId String?
  idempotencyKey        String?     @unique
  description           String?
  metadata              String?     // JSON string
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  settlement            Settlement? @relation(fields: [sourcePaymentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sourcePaymentId])
  @@index([providerTransactionId])
}

model RedemptionRequest {
  id                String    @id @default(cuid())
  userId            String
  amountPaise       Int
  status            String    @default("REQUESTED") // REQUESTED, PROCESSING, COMPLETED, FAILED, REVERSED
  payoutDestination String    // Verified UPI ID
  payoutReference   String?
  failureReason     String?
  idempotencyKey    String?   @unique
  ledgerEntryId     String?   @unique
  requestedAt       DateTime  @default(now())
  processedAt       DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
}

model Referral {
  id                        String    @id @default(cuid())
  referrerId                String
  refereeId                 String    @unique
  status                    String    @default("JOINED") // JOINED, ACTIVE, COMPLETED, FRAUD_FLAGGED
  signupRewardPaidPaise     Int       @default(1100) // ₹11 = 1100 paise
  signupRewardStatus        String    @default("EARNED") // EARNED, PENDING, REVERSED
  qualifyingPaymentCount    Int       @default(0) // Out of 10 qualifying payments
  completionRewardPaidPaise Int       @default(1000) // ₹10 = 1000 paise
  completionRewardStatus    String    @default("PENDING") // PENDING, EARNED, REVERSED
  completedAt               DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  referrer                  User      @relation("ReferralsSent", fields: [referrerId], references: [id], onDelete: Cascade)
  referee                   User      @relation("ReferralReceived", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId, createdAt])
}

model PushSubscription {
  id          String   @id @default(cuid())
  userId      String
  endpoint    String   @unique
  p256dh      String
  auth        String
  userAgent   String?
  platform    String?  // android, ios, desktop, unknown
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([endpoint])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  type        String    // EXPENSE_ADDED, PAYMENT_RECEIVED, CASHBACK_EARNED, etc.
  title       String
  body        String
  url         String?   // Same-origin relative path only
  metadata    String?   // JSON string
  dedupKey    String?   @unique // Durable server-side idempotency across instances/cold starts
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([dedupKey])
}

model Friendship {
  id          String   @id @default(cuid())
  userId      String
  friendId    String
  status      String   @default("ACCEPTED") // PENDING, ACCEPTED, BLOCKED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation("FriendshipsInitiated", fields: [userId], references: [id], onDelete: Cascade)
  friend      User     @relation("FriendshipsReceived", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId, status])
  @@index([friendId, status])
}

model RecurringExpense {
  id               String    @id @default(cuid())
  groupId          String
  description      String
  amount           Int       // In paise (e.g. ₹500.00 = 50000)
  category         String?   @default("OTHER")
  payerId          String
  splitMethod      String    @default("EQUAL") // EQUAL, EXACT, PERCENTAGE, SHARES
  splitData        String?   // JSON configuration of shares/percentages/amounts
  frequency        String    // DAILY, WEEKLY, MONTHLY, YEARLY
  startDate        DateTime
  endDate          DateTime?
  nextOccurrence   DateTime
  lastGeneratedAt  DateTime?
  status           String    @default("ACTIVE") // ACTIVE, PAUSED, CANCELLED, COMPLETED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  group            Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer            User      @relation(fields: [payerId], references: [id], onDelete: Restrict)

  @@index([groupId, status])
  @@index([nextOccurrence, status])
  @@index([payerId])
}




// Phase G: Smart Automations
model AutomationRule {
  id            String   @id @default(cuid())
  userId        String
  name          String
  priority      Int      @default(0)
  
  // Conditions (null means any)
  merchantName  String?
  minAmount     Int?
  maxAmount     Int?
  source        String?
  groupId       String?
  
  // Actions
  setCategory   String?
  
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Phase H: Merchant Intelligence
model Merchant {
  id              String   @id @default(cuid())
  name            String   @unique
  normalizedName  String
  defaultCategory String?
  icon            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  aliases MerchantAlias[]
}

model MerchantAlias {
  id         String   @id @default(cuid())
  merchantId String
  alias      String   @unique
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

// Phase J: Receipt Intelligence - uploaded receipt scanning sessions
model ReceiptScan {
  id              String   @id @default(cuid())
  userId          String
  // PENDING | EXTRACTING | NEEDS_REVIEW | CONFIRMED | FAILED | EXPIRED
  status          String   @default("PENDING")
  imageUrl        String?
  imageMimeType   String?
  imageSizeBytes  Int?
  // JSON: ExtractedReceipt (merchant, date, total, tax, discount, items, confidence, reconciliationWarning)
  extractedData   String?
  // SHA-256 of image bytes for duplicate detection
  fingerprint     String?
  idempotencyKey  String?
  // UPLOAD | SHARE | CAMERA | SCREENSHOT
  source          String   @default("UPLOAD")
  linkedExpenseId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fingerprint])
  @@index([userId, status])
}

// Phase K: Provider-neutral order import
model OrderImport {
  id              String    @id @default(cuid())
  userId          String
  // SWIGGY | ZOMATO | BLINKIT | ZEPTO | BIGBASKET | UNKNOWN
  provider        String    @default("UNKNOWN")
  externalOrderId String?
  merchant        String?
  orderDate       DateTime?
  currency        String    @default("INR")
  subtotalPaise   Int?
  taxPaise        Int?
  deliveryFeePaise Int?
  discountPaise   Int?
  tipPaise        Int?
  totalPaise      Int?
  // JSON array of line items
  itemsJson       String?
  // MANUAL | EMAIL | SCREENSHOT | SHARE | PDF
  importSource    String    @default("MANUAL")
  // PENDING_REVIEW | CONFIRMED | DISMISSED | FAILED
  status          String    @default("PENDING_REVIEW")
  linkedExpenseId String?
  idempotencyKey  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([externalOrderId])
}

// Phase N: Group Chat Messages
model GroupMessage {
  id             String    @id @default(cuid())
  groupId        String
  senderId       String
  body           String
  idempotencyKey String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  group          Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender         User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments    Attachment[]

  @@index([groupId, createdAt])
  @@index([senderId, createdAt])
  @@index([groupId, idempotencyKey])
}

// Phase O: Expense Comments
model ExpenseComment {
  id             String    @id @default(cuid())
  expenseId      String
  authorId       String
  body           String
  idempotencyKey String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  expense        Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  author         User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([expenseId, createdAt])
  @@index([authorId, createdAt])
  @@index([expenseId, idempotencyKey])
}

// Phase P: Attachments
model Attachment {
  id          String   @id @default(cuid())
  ownerId     String
  groupId     String?
  expenseId   String?
  messageId   String?
  storageKey  String
  fileName    String?
  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  sha256      String?
  createdAt   DateTime @default(now())

  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  group       Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  expense     Expense?      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  message     GroupMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([groupId])
  @@index([expenseId])
  @@index([messageId])
  @@index([sha256])
}
